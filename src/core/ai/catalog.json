{
  "updated": "2026-11-21",
  "about": "What each model can do and whether it has a free tier, by model id pattern. Rules are checked in order and the first match wins. Patterns are case-insensitive regular expressions. Free and paid change often and depend on the account, so the app shows them as a guide. What the provider itself reports (Gemini's methods, OpenRouter's modalities and prices) takes precedence.",
  "sources": [
    "https://aistudio.google.com/llms.txt",
    "https://aistudio.google.com/docs/models.md",
    "https://aistudio.google.com/docs/pricing.md",
    "https://platform.claude.com/llms.txt",
    "https://platform.claude.com/docs/en/models/overview.md",
    "https://docs.x.ai/llms.txt",
    "https://docs.x.ai/developers/models.md",
    "https://developers.openai.com/api/docs/llms.txt",
    "https://developers.openai.com/api/docs/models/all.md",
    "https://openrouter.ai/docs/llms.txt",
    "https://openrouter.ai/docs/guides/routing/model-variants/free.md",
    "https://api-docs.deepseek.com/quick_start/pricing",
    "https://docs.mistral.ai/llms.txt",
    "https://docs.mistral.ai/inference/model-selection-guide.md",
    "https://console.groq.com/llms.txt",
    "https://console.groq.com/docs/models.md"
  ],
  "rules": [
    { "provider": "gemini", "match": "^gemini-embedding-2", "group": "embedding", "input": ["text", "image", "audio", "video", "pdf"], "output": [], "tier": "freeTier" },
    { "provider": "gemini", "match": "embedding", "group": "embedding", "input": ["text"], "output": [], "tier": "freeTier" },
    { "provider": "gemini", "match": "^imagen-", "group": "image", "input": ["text"], "output": ["image"], "tier": "paid" },
    { "provider": "gemini", "match": "^veo-", "group": "video", "input": ["text", "image"], "output": ["video", "audio"], "tier": "paid" },
    { "provider": "gemini", "match": "^genie-", "group": "video", "input": ["text", "image"], "output": ["video", "audio"], "tier": "paid" },
    { "provider": "gemini", "match": "^gemini-omni-", "group": "video", "input": ["text", "image", "video"], "output": ["video", "audio"], "tier": "paid" },
    { "provider": "gemini", "match": "^lyria", "group": "special", "input": ["text", "image"], "output": ["audio", "text"], "tier": "paid" },
    { "provider": "gemini", "match": "transcri", "group": "speech", "input": ["audio"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "-pro.*tts", "tier": "paid" },
    { "provider": "gemini", "match": "tts", "group": "speech", "input": ["text"], "output": ["audio"], "tier": "freeTier" },
    { "provider": "gemini", "match": "native-audio|-live|live-|live$|translate", "group": "live", "input": ["text", "audio", "image", "video"], "output": ["text", "audio"], "tier": "freeTier" },
    { "provider": "gemini", "match": "image|nano-banana", "group": "image", "input": ["text", "image"], "output": ["text", "image"], "tier": "paid" },
    { "provider": "gemini", "match": "deep-research|antigravity", "group": "special", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text", "image"], "tier": "paid" },
    { "provider": "gemini", "match": "decision", "group": "special", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "robotics", "group": "special", "input": ["text", "image", "audio", "video"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "computer-use|^aqa|learnlm", "group": "special", "input": ["text", "image"], "output": ["text"], "tier": "unknown" },
    { "provider": "gemini", "match": "^gemma-", "group": "text", "input": ["text", "image"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "^gemini-4-hydrogen", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "^gemini-4-", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "paid" },
    { "provider": "gemini", "match": "^gemini-2\\.5-pro", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "-pro", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "paid" },
    { "provider": "gemini", "match": "flash", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "freeTier" },
    { "provider": "gemini", "match": "^gemini-", "group": "text", "input": ["text", "image", "audio", "video", "pdf"], "output": ["text"], "tier": "unknown" },

    { "provider": "claude", "match": "^claude-", "group": "text", "input": ["text", "image", "pdf"], "output": ["text"], "tier": "paid" },

    { "provider": "openai", "match": ":free$|^openrouter/free$", "tier": "free" },
    { "provider": "openai", "match": "embed", "group": "embedding", "input": ["text"], "output": [] },
    { "provider": "openai", "match": "whisper|transcri|-stt", "group": "speech", "input": ["audio"], "output": ["text"] },
    { "provider": "openai", "match": "tts|speech", "group": "speech", "input": ["text"], "output": ["audio"] },
    { "provider": "openai", "match": "realtime|-live|audio-preview|native-audio|gpt-audio|grok-voice", "group": "live", "input": ["text", "audio"], "output": ["text", "audio"] },
    { "provider": "openai", "match": "dall-e|gpt-image|image-gen|flux|stable-diffusion|sdxl|imagen|-image", "group": "image", "input": ["text", "image"], "output": ["image"] },
    { "provider": "openai", "match": "sora|veo|video", "group": "video", "input": ["text", "image"], "output": ["video"] },
    { "provider": "openai", "match": "^(gpt-[0-9.]+(-[a-z]+)?-(pro|codex)|o[0-9]-pro|codex-mini)", "group": "special", "input": ["text", "image"], "output": ["text"] },
    { "provider": "openai", "match": "-ocr", "group": "special", "input": ["image", "pdf"], "output": ["text"] },
    { "provider": "openai", "match": "moderation|guard|shieldstral|timestral|rerank|computer-use|deep-research", "group": "special", "input": ["text"], "output": ["text"] },
    { "provider": "openai", "match": "voxtral-(small|mini)-[0-9]", "group": "text", "input": ["text", "audio"], "output": ["text"] },
    { "provider": "openai", "match": "vision|-vl|vl-|llava|pixtral|gpt-4o|gpt-4\\.1|gpt-5|gpt-6|chat-latest|^o[134](-|$)|grok-4|grok-build|grok-2-vision|gemini|claude|gemma-3|llama-4|qwen.*vl|qwen3\\.8|mistral-(large|medium|small)|ministral|^deepseek-(flash|v4-flash)", "group": "text", "input": ["text", "image"], "output": ["text"] }
  ],
  "hosts": [
    { "match": "localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\.local(:|/|$)|192\\.168\\.|10\\.\\d+\\.", "tier": "local" },
    { "match": "api\\.openai\\.com|api\\.x\\.ai|api\\.deepseek\\.com|api\\.anthropic\\.com", "tier": "paid" },
    { "match": "openrouter\\.ai", "tier": "paid" },
    { "match": "api\\.groq\\.com", "tier": "freeTier" }
  ]
}
